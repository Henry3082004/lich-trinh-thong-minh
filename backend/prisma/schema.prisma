generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  zaloId      String      @unique
  name        String?
  avatar      String?
  createdAt   DateTime    @default(now())
  itineraries Itinerary[]
  cart        CartItem[]
}

model Place {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  category     String
  description  String
  images       String[]
  lat          Float
  lng          Float
  address      String?
  tags         String[]
  durationMin  Int             @default(60)
  openHours    String?
  sourceUrl    String?
  phone        String?
  mapLink      String?
  // Phân loại nội dung: "place" (điểm đến), "dish" (đặc sản/món ăn), "festival" (lễ hội)
  kind         String          @default("place")
  season       String? // vd "Tháng 3 âm lịch" (lễ hội)
  months       Int[] // tháng dương lịch lễ hội thường diễn ra
  priceNote    String?
  imageCredits String[] // ghi công ảnh: "Tác giả — giấy phép — link"
  sourceUrls   String[]
  items        ItineraryItem[]
  cartItems    CartItem[]

  @@index([category])
}

// Giỏ lịch trình: các mục khách đã "thêm vào lịch trình" khi lướt app, lưu theo tài khoản
model CartItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId String
  place   Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
}

model Itinerary {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  days      Int
  interests String[]
  shareId   String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     ItineraryItem[]

  @@index([userId])
}

model ItineraryItem {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  day         Int
  order       Int
  placeId     String
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Restrict)
  startTime   String?
  note        String?

  @@index([itineraryId])
}

// Ảnh lịch trình do người dùng tạo, lưu tạm để Zalo có link công khai khi chia sẻ
model Poster {
  id        String   @id
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
