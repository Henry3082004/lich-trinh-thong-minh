DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daksong"
# zalo = xác thực token Zalo thật (production); dev = cho phép header X-Dev-User để test
AUTH_MODE=dev
# Origin được phép gọi API, cách nhau bởi dấu phẩy; * = tất cả
CORS_ORIGIN=*
# Tuỳ chọn: secret key của Zalo app, dùng để gửi appsecret_proof khi xác thực token
ZALO_APP_SECRET=
# Máy chủ ảnh được phép lấy qua /api/img, cách nhau bởi dấu phẩy
IMAGE_HOSTS=static.dggv.edu.vn
# Địa chỉ công khai của API (để tạo link ảnh poster). Bỏ trống thì suy ra từ request
PUBLIC_BASE_URL=
# Ảnh poster tự xoá sau bao nhiêu ngày, và số lần tải ảnh lên mỗi giờ của mỗi người
POSTER_TTL_DAYS=30
POSTER_UPLOADS_PER_HOUR=30

# Khoá Google Places API (New) để hiện điểm sao và review Google; bỏ trống thì tắt tính năng này
GOOGLE_MAPS_API_KEY=
# Khoá Gemini API (Google AI Studio) cho chatbot hỏi đáp; bỏ trống thì tắt chatbot
GEMINI_API_KEY=
# Tên model Gemini (đổi nếu Google ngừng model này) và số câu hỏi tối đa mỗi người mỗi giờ
GEMINI_MODEL=gemini-flash-latest
CHAT_PER_HOUR=40
